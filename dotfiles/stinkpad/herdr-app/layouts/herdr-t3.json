{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.10"
  },
  "type": "row",
  "preview": "layouts/herdr-t3.svg",
  "divider": { "width": 1, "color": "border" },
  "terminal_menu": "t3-menu",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "t3-chrome"
          },
          "size": {
            "px": 40
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "stack",
          "active": "inbox",
          "children": [
            {
              "id": "lists",
              "type": "column",
              "children": [
                {
                  "id": "spaces",
                  "type": "block",
                  "size": { "weight": 1 },
                  "min": 90,
                  "content": { "mod": "t3-spaces", "props": { "newMenu": "t3-new-menu" } }
                },
                {
                  "id": "agents",
                  "type": "block",
                  "size": { "weight": 1 },
                  "min": 90,
                  "content": { "mod": "t3-agents" }
                }
              ]
            },
            {
              "id": "inbox",
              "type": "block",
              "content": { "mod": "t3-inbox", "props": { "newMenu": "t3-new-menu", "picker": "t3-picker", "home": "t3-tabs.home" } }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "t3-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 44
          }
        }
      ],
      "size": {
        "px": 256
      },
      "min": 208,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs-row",
          "type": "row",
          "size": { "px": 40 },
          "resizable": false,
          "background": "chrome",
          "children": [
            { "id": "tabs", "type": "block", "size": { "weight": 1 }, "window_drag": true, "content": { "mod": "t3-tabs" } },
            { "id": "actions", "type": "block", "size": { "px": 108 }, "window_drag": true, "content": { "mod": "t3-actions", "props": { "block": "actions" } } },
            { "id": "tabs-end", "type": "block", "size": { "px": 36 }, "window_drag": true, "content": { "mod": "t3-tabs", "props": { "part": "end", "block": "tabs-end" } } }
          ]
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "t3-pane"
                    },
                    "reveal": "always",
                    "height": 28,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 2,
                    "color": "background"
                  },
                  "focus": {
                    "width": 2,
                    "color": "background"
                  },
                  "radius": 8,
                  "gap": 8,
                  "lone": true
                }
              }
            }
          ],
          "padding": [0, 8],
          "gap": 8
        },
        {
          "id": "work-bottom-inset",
          "type": "row",
          "children": [
            { "id": "bar-measure", "type": "block", "size": { "weight": 1 }, "content": { "mod": "t3-tabs", "props": { "part": "measure" } } }
          ],
          "size": { "px": 8 }
        },
        {
          "id": "status",
          "type": "block",
          "hidden": true,
          "size": { "px": 28 },
          "content": { "mod": "workspace-status" }
        }
      ],
      "background": "chrome",
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_opacity": 0,
  "terminal_padding": [
    8,
    0
  ],
  "titlebar": "none",
  "traffic_lights": [
    16,
    13
  ]
}
