                          "header": {
                            "content": {
                              "mod": "pane"
                            },
                            "reveal": "always",
                            "height": 30,
                            "position": "top"
                          },
                          "background": "background",
                          "border": {
                            "width": 1,
                            "color": "canvas"
                          },
                          "focus": {
                            "width": 1,
                            "color": "canvas"
                          },
                          "radius": 10,
                          "gap": 8,
                          "lone": true
                        }
                      }
                    }
                  ],
                  "padding": 8,
                  "gap": 8
                }
              ],
              "resizable": false
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "my-files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    },
                    {
                      "id": "graph",
                      "type": "block",
                      "content": {
                        "mod": "git-graph"
                      }
                    },
                    {
                      "id": "automations",
                      "type": "block",
                      "content": {
                        "mod": "automations"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            },
            {
              "id": "todo",
              "type": "block",
              "content": {
                "mod": "over9k-todos"
              },
              "size": {
                "px": 368
              },
              "hidden": true
            },
            {
              "id": "timeline",
              "type": "block",
              "content": {
                "mod": "over9k-prompts"
              },
              "size": {
                "px": 368
              },
              "hidden": true
            }
          ]
        },
        {
          "id": "status",
          "type": "row",
          "children": [
            {
              "id": "status-info",
              "type": "block",
